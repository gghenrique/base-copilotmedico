# ============================================================================
# CoPilot Medico - variaveis de ambiente do backend (B12)
#
# Como usar:
#   cp API/.env.example API/.env     # e preencha os valores marcados <...>
#
# Este arquivo e lido em dois cenarios:
#   - Docker : o docker-compose.yml o injeta via `env_file: ./API/.env`
#   - Nativo : backend/config.py o carrega de API/.env (pydantic-settings)
#
# NUNCA comite o .env preenchido - ele esta no .gitignore.
# ============================================================================

# ----------------------------------------------------------------------------
# IA - Google Gemini                                            [OBRIGATORIO]
# ----------------------------------------------------------------------------
# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# Sem ela o backend sobe, mas toda rota que chama a IA falha.
GEMINI_API_KEY=<sua-chave-do-google-ai-studio>

# ----------------------------------------------------------------------------
# Autenticacao - assinatura dos tokens JWT                      [OBRIGATORIO]
# ----------------------------------------------------------------------------
# Segredo usado para assinar/validar os JWT. Se ficar vazio, TODA rota
# autenticada responde 500 (D-22).
# Gere um valor forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=<string-aleatoria-longa>

# Validade do token de acesso, em minutos.
AUTH_TOKEN_EXPIRATION_MINUTES=60

# ----------------------------------------------------------------------------
# Autenticacao - bootstrap do administrador                     [OBRIGATORIO]
# ----------------------------------------------------------------------------
# Na primeira subida o backend cria este usuario administrador. Sem estes
# valores nenhum admin e criado e ninguem consegue entrar no sistema (D-23).
# Os medicos se cadastram sozinhos e ficam pendentes ate a aprovacao do admin.
AUTH_BOOTSTRAP_EMAIL=admin@exemplo.local
AUTH_BOOTSTRAP_PASSWORD=<senha-forte-do-admin>
AUTH_BOOTSTRAP_NAME=Administrador
AUTH_BOOTSTRAP_PROFILES=administrador

# ----------------------------------------------------------------------------
# CORS                                                            [OPCIONAL]
# ----------------------------------------------------------------------------
# Origens liberadas para /api/*. Use "*" apenas em desenvolvimento.
# Em producao, liste as origens separadas por virgula. A extensao Chrome
# tem origem chrome-extension://<id> e nao e coberta por "*" com credenciais.
# Padrao do compose: web em 8080 (container) e 5174 (vite dev).
CORS_ORIGINS=http://localhost:8080,http://localhost:5174

# ----------------------------------------------------------------------------
# Banco de dados                                                  [OPCIONAL]
# ----------------------------------------------------------------------------
# ATENCAO: nesta versao a persistencia ainda e o arquivo JSON
# backend/patients_db.json. O PostgreSQL ja sobe no compose e DB_URL ja e
# lido por backend/config.py, mas a migracao do JSON -> Postgres ainda nao
# foi feita. Esta variavel existe para a migracao e para os testes.
#
# Credenciais do container PostgreSQL.                        [OBRIGATORIO]
# O servico `db` do compose le estas variaveis DIRETAMENTE deste arquivo
# (env_file). Nao existe senha default no docker-compose.yml: se
# POSTGRES_PASSWORD ficar vazia, o container do Postgres recusa a subir - por
# design, para que nenhuma senha viaje no versionamento.
# Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=copmed
POSTGRES_PASSWORD=<senha-do-postgres>
POSTGRES_DB=copmed

# String de conexao usada pela aplicacao. Usuario, senha e banco devem bater
# com as tres variaveis acima; `db` e o nome do servico no compose.
DB_URL=postgresql+psycopg://copmed:<senha-do-postgres>@db:5432/copmed
#
# Para rodar o backend fora do Docker apontando ao Postgres do compose:
# DB_URL=postgresql+psycopg://copmed:<senha-do-postgres>@localhost:5432/copmed

# ----------------------------------------------------------------------------
# Frontend web (copmed-web)                                       [OPCIONAL]
# ----------------------------------------------------------------------------
# URL da API embutida no bundle do Vite em tempo de BUILD.
# Alterar exige rebuild: docker compose build copmed-web
VITE_API_URL=http://localhost:3001

# Titulo exibido pela aplicacao.
APP_TITLE=Copilot Medico
